{
  "name": "nautilo",
  "version": "0.2.15",
  "private": true,
  "description": "A local, user-configurable multi-agent coding workspace.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "build:desktop": "pnpm build && pnpm --filter @agenthub/desktop build",
    "package:win": "pnpm build:desktop && node scripts/package-win-portable.mjs",
    "package": "pnpm build:desktop && node scripts/prepare-packaged-resources.mjs build/packaged && electron-builder",
    "typecheck": "tsc -b tsconfig.json --pretty false && pnpm --filter @agenthub/desktop typecheck",
    "test": "pnpm -r --if-present test && node tests/contract/contracts.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @agenthub/core-daemon dev",
    "dev:daemon": "pnpm --filter @agenthub/core-daemon serve",
    "dev:desktop": "node scripts/dev-desktop.mjs",

    "rust:build": "node scripts/rust-build.mjs",
    "rust:release": "node scripts/rust-build.mjs --release",
    "tauri:renderer": "pnpm --filter @agenthub/desktop exec vite build --config vite.tauri.config.mts",
    "tauri:build": "pnpm tauri:renderer && set \"PATH=%CD%\\.toolchains\\mingw64\\bin;%PATH%\" && cd apps\\desktop\\src-tauri && cargo build --release",
    "dev:tauri": "pnpm rust:build && pnpm tauri:renderer && set \"PATH=%CD%\\.toolchains\\mingw64\\bin;%PATH%\" && cd apps\\desktop\\src-tauri && cargo run",
    "package:tauri": "set \"PATH=%CD%\\.toolchains\\mingw64\\bin;%PATH%\" && node scripts/package-win-tauri.mjs --build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron-builder": "^26.0.12",
    "rcedit": "^5.0.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
