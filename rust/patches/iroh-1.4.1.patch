+//! Bounded RFC 5389 discovery on the very same sockets used for QUIC.
+//! A mapping from another socket is not a usable hole-punching candidate.
+use netwatch::UdpSocket;
+use std::{
+    collections::HashMap,
+    io,
+    net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr},
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use tokio::sync::oneshot;
+
+const COOKIE: [u8; 4] = [0x21, 0x12, 0xa4, 0x42];
+type Pending = HashMap<[u8; 12], (SocketAddr, oneshot::Sender<SocketAddr>)>;
+
+#[derive(Clone, Debug)]
+pub(crate) struct Probe {
+    socket: Arc<UdpSocket>,
+    pending: Arc<Mutex<Pending>>,
+}
+
+impl Probe {
+    pub(crate) fn new(socket: Arc<UdpSocket>) -> Self {
+        Self {
+            socket,
+            pending: Arc::new(Mutex::new(HashMap::new())),
+        }
+    }
+    pub(crate) fn local_addr(&self) -> io::Result<SocketAddr> {
+        self.socket.local_addr()
+    }
+
+    #[cfg(target_os = "android")]
+    pub(crate) fn bind_android_network(&self, handle: u64) -> io::Result<()> {
+        self.socket.bind_android_network(handle)
+    }
+
+    pub(crate) async fn discover(
+        &self,
+        server: SocketAddr,
+        timeout: Duration,
+    ) -> io::Result<SocketAddr> {
+        let id: [u8; 12] = rand::random();
+        let (tx, mut rx) = oneshot::channel();
+        {
+            let mut pending = self.pending.lock().unwrap();
+            if pending.len() >= 16 {
+                return Err(io::Error::other("too many STUN probes"));
+            }
+            pending.insert(id, (server, tx));
+        }
+        struct Cleanup<'a>(&'a Mutex<Pending>, [u8; 12]);
+        impl Drop for Cleanup<'_> {
+            fn drop(&mut self) {
+                self.0.lock().unwrap().remove(&self.1);
+            }
+        }
+        let _cleanup = Cleanup(&self.pending, id);
+        let mut request = [0u8; 20];
+        request[1] = 1; // Binding request, no attributes.
+        request[4..8].copy_from_slice(&COOKIE);
+        request[8..20].copy_from_slice(&id);
+        let deadline = tokio::time::Instant::now() + timeout.min(Duration::from_secs(5));
+        for delay in [250, 500, 1000, 2000] {
+            tokio::time::timeout_at(deadline, self.socket.send_to(&request, server))
+                .await
+                .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "STUN send timed out"))??;
+            let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match tokio::time::timeout(remaining.min(Duration::from_millis(delay)), &mut rx).await {
+                Ok(Ok(addr)) => return Ok(addr),
+                Ok(Err(_)) => return Err(io::Error::other("STUN probe closed")),
+                Err(_) => (),
+            }
+        }
+        Err(io::Error::new(
+            io::ErrorKind::TimedOut,
+            "STUN binding timed out",
+        ))
+    }
+
+    /// Called by the normal UDP receiver; never runs a second competing reader.
+    pub(crate) fn accept(&self, server: SocketAddr, packet: &[u8]) -> bool {
+        if packet.len() < 20 || packet[..2] != [1, 1] || packet[4..8] != COOKIE {
+            return false;
+        }
+        let id: [u8; 12] = packet[8..20].try_into().unwrap();
+        let mut pending = self.pending.lock().unwrap();
+        let Some((expected, _)) = pending.get(&id) else {
+            return false;
+        };
+        if expected.ip().to_canonical() != server.ip().to_canonical()
+            || expected.port() != server.port()
+        {
+            return false;
+        }
+        let Some(addr) = mapped_address(packet) else {
+            return false;
+        };
+        if let Some((_, tx)) = pending.remove(&id) {
+            let _ = tx.send(addr);
+        }
+        true
+    }
+}
+
+fn mapped_address(packet: &[u8]) -> Option<SocketAddr> {
+    let end =
+        20usize.checked_add(u16::from_be_bytes(packet.get(2..4)?.try_into().ok()?) as usize)?;
+    if end > packet.len() || end % 4 != 0 {
+        return None;
+    }
+    let mut at = 20;
+    while at + 4 <= end {
+        let kind = u16::from_be_bytes(packet[at..at + 2].try_into().ok()?);
+        let len = u16::from_be_bytes(packet[at + 2..at + 4].try_into().ok()?) as usize;
+        let value = packet
+            .get(at + 4..at + 4 + len)
+            .filter(|_| at + 4 + len <= end)?;
+        if kind == 0x0020 && len >= 8 && value[0] == 0 {
+            let port = u16::from_be_bytes(value[2..4].try_into().ok()?) ^ 0x2112;
+            let ip = match (value[1], len) {
+                (1, 8) => IpAddr::V4(Ipv4Addr::from(std::array::from_fn::<_, 4, _>(|i| {
+                    value[4 + i] ^ COOKIE[i]
+                }))),
+                (2, 20) => IpAddr::V6(Ipv6Addr::from(std::array::from_fn::<_, 16, _>(|i| {
+                    value[4 + i] ^ packet[4 + i]
+                }))),
+                _ => return None,
+            }
+            .to_canonical();
+            if port == 0 || ip.is_unspecified() || ip.is_loopback() || ip.is_multicast() {
+                return None;
+            }
+            return Some(SocketAddr::new(ip, port));
+        }
+        at += 4 + (len + 3) / 4 * 4;
+    }
+    None
+}
