+    /// Probes RFC 5389 STUN on each bound UDP socket of the server's IP family.
+    /// Returns (local socket, observed external socket) pairs. Does not advertise
+    /// results automatically; applications must expire them and avoid reporting
+    /// a successful path until QUIC connectivity has actually been verified.
+    #[cfg(not(wasm_browser))]
+    pub async fn probe_stun(&self, server: SocketAddr, timeout: std::time::Duration) -> Vec<(SocketAddr, SocketAddr)> {
+        if self.is_closed() { return Vec::new(); }
+        let mut probes = tokio::task::JoinSet::new();
+        for probe in &self.inner.stun_probes {
+            let Ok(local) = probe.local_addr() else { continue };
+            if local.is_ipv4() != server.is_ipv4() { continue; }
+            let probe = probe.clone();
+            probes.spawn(async move { probe.discover(server, timeout).await.map(|mapped| (local, mapped)) });
+        }
+        let mut result = Vec::new();
+        while let Some(outcome) = probes.join_next().await {
+            if let Ok(Ok(mapping)) = outcome { result.push(mapping); }
+        }
+        result
+    }
+
