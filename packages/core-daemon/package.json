{
  "name": "@agenthub/core-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "serve": "pnpm build && node dist/index.js --serve",
    "dev": "pnpm build && pnpm start",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@agenthub/domain": "workspace:*",
    "@agenthub/event-protocol": "workspace:*",
    "@agenthub/provider-sdk": "workspace:*",
    "@agenthub/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
